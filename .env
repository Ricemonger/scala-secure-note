POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres

BACKEND_HOST=backend
BACKEND_PORT=8081

FRONTEND_HOST=frontend
FRONTEND_PORT=8091

# ^[a-zA-Z0-9_.-]{4,20}$
CONSTRAINT_USERNAME_REGEX="^[a-zA-Z0-9_.-]{4,20}$$"
CONSTRAINT_USERNAME_MESSAGE="Username must be between 4 and 20 characters and contain only letters, numbers and characters: _.-"

# ^[a-zA-Z0-9!@#$%^&*()_+\\-=\\[\\]{};':\"\\\\|,.<>/?]{4,24}$
CONSTRAINT_PASSWORD_REGEX="^[a-zA-Z0-9!@#$$%^&*()_+\\-=\\[\\]{};':\"\\\\|,.<>/?]{4,24}$$"
CONSTRAINT_PASSWORD_MESSAGE="Password must be between 4 and 24 characters and contain only letters, numbers and characters: !@#$$%^&*()_+-=[]{};':\"\\|,.<>/?"